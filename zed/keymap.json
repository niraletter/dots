[
  {
    "context": "Workspace",
    "bindings": {
      "alt-`": ["task::Spawn", { "task_name": "Run Dart file" }]
    }
  },
  {
    "context": "Editor",
    "bindings": {
      "ctrl-shift-c": "editor::Copy",
      "ctrl-shift-v": "editor::Paste"
    }
  },
  {
    "context": "Terminal",
    "bindings": {
      "super-c": "terminal::Copy",
      "super-v": "terminal::Paste"
    }
  }
]
