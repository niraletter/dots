{
  "autosave": {
    "after_delay": {
      "milliseconds": 300
    }
  },
  "mouse_wheel_zoom": true,
  "ui_font_size": 13.0,
  "buffer_font_size": 12.0,
  "ui_font_family": "JetBrainsMono Nerd Font",
  "agent_servers": {
    "github-copilot-cli": {
      "type": "registry"
    },
    "opencode-v2": {
      "type": "registry"
    }
  },
  "disable_ai": true,
  "cli_default_open_behavior": "existing_window",
  "theme": "Omazed",
  "buffer_font_family": "JetBrainsMono Nerd Font"
}
